# ---------------------------------------------------------------------------
# SMTP for the contact form.
# Any of three naming schemes works — EMAIL_SERVER_* (used by cheers/polyedge),
# SMTP_*, or this site's original EMAIL / EMAIL_PASS pair.
# ---------------------------------------------------------------------------

EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Optional
# EMAIL_FROM="Maxwell Wedderburn <you@example.com>"
# CONTACT_TO=maxwellwedderburn32@gmail.com

# ---------------------------------------------------------------------------
# Optional. Only the Random Player and Perspective demos under /lab use this.
# Both degrade gracefully without it — Random Player falls back to a curated
# video list, Perspective shows an error toast on playlist load.
# Google Cloud console > APIs & Services > Credentials > YouTube Data API v3
# ---------------------------------------------------------------------------
# YT_KEY=

# ---------------------------------------------------------------------------
# Optional. Seeds the Random Player's search term.
# Without it a built-in word list is used, so the demo works unconfigured.
# ---------------------------------------------------------------------------
# WORDNIK_KEY=
